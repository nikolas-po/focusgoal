/* 
   FocusGoal — Светлая тема
   Подключается ПОСЛЕ common.qss, переопределяет цвета
    */

QWidget        { background-color: #f5f5f5; color: #212121; }
QMainWindow    { background-color: #f5f5f5; }
QDialog        { background-color: #f5f5f5; }
QLabel         { color: #212121; background: transparent; }
QScrollArea    { background-color: palette(window); }

/* Поля ввода */
QLineEdit, QComboBox, QSpinBox, QTimeEdit, QDateEdit {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 8px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #4CAF50; }
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #212121;
    selection-background-color: #4CAF50;
    selection-color: #ffffff;
    border: 1px solid #cccccc;
}

/* Кнопки */
/* Общие правила кнопок определяются в common.qss */

/* Группы */
QGroupBox { color: #212121; border: 1px solid #cccccc; background: transparent; }
QGroupBox::title { color: #212121; }

/* Чекбоксы */
QCheckBox, QRadioButton { color: #212121; }
QCheckBox::indicator, QRadioButton::indicator {
    border: 1px solid #cccccc;
    background: #ffffff;
    width: 14px;
    height: 14px;
    border-radius: 2px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #4CAF50;
    border-color: #4CAF50;
}

/* Вкладки */
QTabWidget::pane  { border: 1px solid #cccccc; background-color: #f5f5f5; }
QTabBar::tab      { background-color: #e8e8e8; color: #212121; border: 1px solid #cccccc; }
QTabBar::tab:selected { background-color: #4CAF50; color: #ffffff; }
QTabBar::tab:hover    { background-color: #d5d5d5; }

/* Прокрутка */
QScrollBar:vertical   { background-color: #f5f5f5; width: 12px; }
QScrollBar::handle:vertical { background-color: #cccccc; border-radius: 6px; }
QScrollBar::handle:vertical:hover { background-color: #aaaaaa; }
QScrollBar:horizontal { background-color: #f5f5f5; height: 12px; }
QScrollBar::handle:horizontal { background-color: #cccccc; border-radius: 6px; }

/* Прогресс */
QProgressBar { border: 1px solid #cccccc; background-color: #e8e8e8; color: #212121; border-radius: 5px; }
QProgressBar::chunk { background-color: #4CAF50; border-radius: 4px; }

/* Меню */
QMenu { background-color: #ffffff; border: 1px solid #cccccc; }
QMenu::item { color: #212121; }
QMenu::item:selected { background-color: #4CAF50; color: #ffffff; }
QMenuBar { background-color: #eeeeee; color: #212121; border-bottom: 1px solid #cccccc; }
QMenuBar::item:selected { background-color: #4CAF50; color: #ffffff; }

/* Toolbar */
QToolBar   { background-color: #f5f5f5; border: 1px solid #cccccc; }
QToolButton {
    color: #212121;
}
QToolButton:hover { background-color: #e0e0e0; border: 1px solid #cccccc; }

/* Таблицы */
QHeaderView::section { background-color: #e8e8e8; color: #212121; border: 1px solid #cccccc; }
QTableWidget, QTreeWidget, QListWidget {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #cccccc;
    gridline-color: #e0e0e0;
}
QTableWidget::item:alternate { background-color: #f9f9f9; }
QTableWidget::item:selected, QListWidget::item:selected {
    background-color: #4CAF50;
    color: #ffffff;
}

/* Текстовые поля */
QTextEdit, QPlainTextEdit { background-color: #ffffff; color: #212121; border: 1px solid #cccccc; }

/* Разделители */
QSplitter::handle { background-color: #cccccc; }

/* Диалоги/сообщения */
QMessageBox        { background-color: #f5f5f5; }
QMessageBox QLabel { color: #212121; }
QCalendarWidget    { background-color: #ffffff; color: #212121; }
QInputDialog, QFileDialog { background-color: #f5f5f5; color: #212121; }

/* Строка статуса */
QStatusBar { background-color: #eeeeee; color: #555555; border-top: 1px solid #cccccc; }

/* Карточки — явно задаём светлый фон */
QFrame#cardFrame,
QFrame#statCard,
QFrame#profileCard,
QFrame#loginCard,
QFrame#registerCard {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
}
